    "is_deprecated": false,
    "source": {
      "code": "from decimal import Decimal, DecimalException, localcontext\nimport re\n\ndef generate():\n    return []\n\ndef check(reply, clue):\n    answer = reply.split()\n    expected = clue.split()\n    if len(answer) != 1 or len(expected) != 1:\n        return False\n    number = r\"[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?\"\n    if any(re.fullmatch(number, token) is None for token in answer):\n        return False\n    try:\n        with localcontext() as ctx:\n            ctx.prec = 60\n            tolerance = Decimal(\"1e-7\")\n            for actual, target in zip(answer, expected):\n                actual, target = Decimal(actual), Decimal(target)\n                if not actual.is_finite() or not target.is_finite():\n                    return False\n                if abs(actual - target) > max(tolerance, tolerance * abs(target)):\n                    return False\n    except (DecimalException, ValueError):\n        return False\n    return True\n",
      "execution_time_limit": 5,
      "execution_memory_limit": 256,
      "samples_count": 1,
