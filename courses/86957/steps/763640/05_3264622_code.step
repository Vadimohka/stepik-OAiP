    "is_deprecated": false,
    "source": {
      "code": "from decimal import Decimal, DecimalException, localcontext\n\ndef generate():\n    return []\n\ndef check(reply, clue):\n    actual = reply.split()\n    expected = str(clue).split()\n    if len(actual) != 1 or len(expected) != 1:\n        return False\n    try:\n        with localcontext() as context:\n            context.prec = 60\n            value, reference = Decimal(actual[0]), Decimal(expected[0])\n            if not value.is_finite() or not reference.is_finite():\n                return False\n            tolerance = max(Decimal(\"1e-9\"), Decimal(\"1e-9\") * abs(reference))\n            return abs(value - reference) <= tolerance\n    except (DecimalException, ValueError, TypeError):\n        return False\n",
