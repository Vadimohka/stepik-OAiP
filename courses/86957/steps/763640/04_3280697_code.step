    "is_deprecated": false,
    "source": {
      "code": "import re\nfrom decimal import Decimal, DecimalException, localcontext\n\ndef generate():\n    return []\n\ndef check(reply, clue):\n    actual, expected = reply.split(), str(clue).split()\n    if len(actual) != 5 or len(expected) != 5:\n        return False\n    if any(re.fullmatch(r\"[+-]?[0-9]+\", token) is None for token in actual[:2]):\n        return False\n    try:\n        if [int(token) for token in actual[:2]] != [int(token) for token in expected[:2]]:\n            return False\n        with localcontext() as context:\n            context.prec = 60\n            for token, reference_token in zip(actual[2:], expected[2:]):\n                value, reference = Decimal(token), Decimal(reference_token)\n                if not value.is_finite() or not reference.is_finite():\n                    return False\n                tolerance = max(Decimal(\"1e-9\"), Decimal(\"1e-12\") * abs(reference))\n                if abs(value - reference) > tolerance:\n                    return False\n        return True\n    except (DecimalException, ValueError, TypeError):\n        return False\n",
      "execution_time_limit": 5,
      "execution_memory_limit": 256,
