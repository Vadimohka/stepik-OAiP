          "is_correct": true,
          "text": "Time complexity линейного поиска $O(n)$",
          "feedback": "Почитайте про линейный поиск"
        },
        {
          "is_correct": true,
          "text": "Бинарный поиск используется для отсортированных массивов",
          "feedback": "Почитайте про бинарный поиск"
