        {
          "is_correct": true,
          "text": "Интерполяционный поиск используется для отсортированных массивов",
          "feedback": "Почитайте про интерполяционный поиск"
        },
        {
          "is_correct": true,
          "text": "Time complexity бинарного поиска $O(\\log{n})$",
          "feedback": "Почитайте про бинарный поиск"
        },
        {
          "is_correct": true,
          "text": "Для интерполяционного поиска m = l + floor((x − a[l]) · (r − l) / (a[r] − a[l])).",
