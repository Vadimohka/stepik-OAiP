        {
          "is_correct": true,
          "text": "int mat[][2] = {1, 2, 3}; // корректная запись",
          "feedback": "Получается int[2][2]: строки {1,2} и {3,0}."
        },
        {
          "is_correct": false,
          "text": "int mat[2][] = {1, 2, 3}; // корректная запись",
