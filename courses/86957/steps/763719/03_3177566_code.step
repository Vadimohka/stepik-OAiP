        "c++": "#include <iostream>\n\nint main() {\n    int n{};\n    std::cin >> n;\n    int i = 1;\n    while (i < n) {\n        std::cout << i << \" * \" << i << \" = \" << 1LL * i * i << '\\n';\n        ++i;\n    }\n    return 0;\n}"
      },
