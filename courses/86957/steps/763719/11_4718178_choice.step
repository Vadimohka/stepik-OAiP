      "is_options_feedback": true,
      "options": [
        {
          "is_correct": true,
          "text": "++x обозначает уже изменённый x со значением 4; x++ даёт прежнее значение 3. После каждого отдельного выражения x равно 4.",
          "feedback": ""
        },
        {
          "is_correct": false,
          "text": "Оба выражения дают прежнее значение 3.",
          "feedback": ""
        },
        {
          "is_correct": false,
          "text": "Постинкремент не изменяет x.",
          "feedback": ""
        },
        {
