    "is_deprecated": false,
    "source": {
      "code": "\n\nmy_tests = [('1\\n',1), ('2\\n',2), ('4\\n',4), ('9\\n', 9), ('3\\n', 3), ('8\\n',8), ('18\\n',18), ('25\\n',25), ('204\\n',204), ('511\\n', 511), ('1234\\n',1234), ('1450\\n', 1450), ('1453\\n', 1453), ('1454\\n',1454)]\n\ndef generate():\n    return my_tests\n\ndef is_square (l: list, order: int):\n    if len(l) != order:\n        return False\n    for raw in l:\n        if len(raw) != order:\n            return False\n    return True\n\ndef are_nums_different(l: list, order):\n    s = set()\n    for raw in l:\n        for el in raw:\n            s.add(el)\n    return len(s) == order*order\n\ndef sum_column(l: list, ind: int):\n    sum = 0\n    for col_ind in range(len(l)):\n        sum += l[col_ind][ind]\n    return sum\n\ndef check_magic_square(s, order):\n    #fastly check order 2\n    if order == 2:\n        if s == 'NO':\n            return True\n        else:\n            return False\n    \n    #convert ouput to 2d array, if possible\n    try:\n        l = [[int(i) for i in str.strip().split()] for str in s.splitlines()]\n    except Exception:\n        return False\n    \n    #check if output is square and has the size we need\n    if not is_square(l, order) or not are_nums_different(l, order):\n        return False\n    \n    #check the square itself\n    sz = len(l)\n    expected_sum = sum([l[i][i] for i in range(sz)])\n    \n    if sum([l[i][sz-i-1] for i in range(sz)]) != expected_sum:\n       return False\n       \n    for raw in l:\n        if sum(raw) != expected_sum:\n            return False\n        \n    for column_index in range(len(l)):\n        if(sum_column(l, column_index)) != expected_sum:\n            return False\n        \n    #checked all invalid states\n    return True\n\ndef check(reply, clue):\n    return check_magic_square(reply.strip(), int(clue))\n",
      "execution_time_limit": 2,
